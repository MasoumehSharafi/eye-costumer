# edsAI product-data service
EDSAI_BASE_URL=https://your-edsai-service.example
EDSAI_CENTRAL_BRAIN_RENEWAL_KEY=replace_me

# Local language model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Brain API authentication
BRAIN_CUSTOMER_API_KEY=replace_with_a_long_random_value
BRAIN_INTERNAL_API_KEY=replace_with_a_different_long_random_value
BRAIN_DOCTOR_API_KEY=replace_with_a_different_long_random_value

# Shopify app to Brain connection
BRAIN_API_URL=http://127.0.0.1:8000
BRAIN_REQUEST_TIMEOUT_MS=240000
CHAT_SESSION_SECRET=replace_with_a_long_random_value
CHAT_ALLOWED_ORIGINS=https://your-store.myshopify.com

# Shopify CLI supplies these during development
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SHOPIFY_APP_URL=https://your-app.example
SCOPES=unauthenticated_read_product_listings,write_app_proxy

